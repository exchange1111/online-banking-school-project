<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Bank | Admin</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="container">
        <div class="brand">Urban Bank</div>
        <div class="nav-links">
          <a href="/admin">Admin Panel</a>
          <form action="/logout" method="POST" style="display:inline;">
            <button type="submit">Logout</button>
          </form>
        </div>
      </div>
    </nav>

    <main class="container page-header">
      <h1>Admin Control Panel</h1>
      <p class="muted">Manage customer balances and approve token-based withdrawals</p>

      <div class="stat-grid" style="margin-bottom: 26px;">
        <div class="stat-item">
          <strong>Total System Balance</strong>
          <div>$<%= Number(totalBalance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
        </div>
        <div class="stat-item">
          <strong>Users</strong>
          <div><%= users.length %></div>
        </div>
        <div class="stat-item">
          <strong>Pending Requests</strong>
          <div><%= requests.filter((r) => r.status === 'pending').length %></div>
        </div>
      </div>

      <div class="dashboard-grid">
        <section class="card">
          <h3>Customer Accounts</h3>
          <table class="table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Balance</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach((account) => { %>
                <tr>
                  <td><%= account.name %></td>
                  <td><%= account.email %></td>
                  <td>$<%= Number(account.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                  <td>
                    <form action="/admin/users/<%= account.id %>/balance" method="POST" style="display:flex; gap:8px;">
                      <input type="number" step="0.01" name="balance" value="<%= account.balance %>" style="width:100px;" />
                      <button class="btn btn-success" type="submit">Update</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </section>

        <section class="card">
          <h3>Withdrawal Requests</h3>
          <% if (requests.length === 0) { %>
            <p class="muted">No withdrawal requests yet.</p>
          <% } else { %>
            <% requests.forEach((request) => { %>
              <div style="border: 1px solid #e3ebf8; padding: 14px; border-radius: 12px; margin-bottom: 14px;">
                <strong>User ID:</strong> <%= request.userId %><br />
                <strong>Amount:</strong> $<%= Number(request.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %><br />
                <strong>Status:</strong> <span class="badge <%= request.status %>"><%= request.status %></span><br />
                <% if (request.token) { %>
                  <strong>Token:</strong> <%= request.token %>
                <% } else { %>
                  <form action="/admin/tokens/<%= request.id %>/issue" method="POST" style="margin-top: 10px;">
                    <input type="text" name="note" placeholder="Approval note" />
                    <button class="btn btn-primary" type="submit" style="margin-top: 10px;">Issue Token</button>
                  </form>
                <% } %>
              </div>
            <% }); %>
          <% } %>
        </section>
      </div>
    </main>
  </body>
</html>
