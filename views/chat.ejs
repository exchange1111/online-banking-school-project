<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Bank | Support</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="main-header">
      <div class="container header-inner">
        <div class="brand">
          <span class="brand-mark">U</span>
          <span>Urban Bank</span>
        </div>

        <nav class="nav-menu">
          <a href="/dashboard">Dashboard</a>
          <form action="/logout" method="POST" style="display:inline; margin:0;">
            <button type="submit">Logout</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <div class="container">
        <h1 class="page-title">Support chat</h1>
        <p class="subtle">Request a withdrawal token and speak with support.</p>

        <div class="card" style="margin-top: 24px;">
          <div class="chat-box">
            <% messages.forEach((msg) => { %>
              <div class="message <%= msg.sender %>">
                <div style="font-weight: 700; margin-bottom: 6px;">
                  <%= msg.sender === 'user' ? user.name : 'Support' %>
                </div>
                <div><%= msg.text %></div>
              </div>
            <% }); %>
          </div>

          <form action="/chat/message" method="POST" style="margin-top: 20px;">
            <div class="inline-form">
              <input type="text" name="message" placeholder="Type your message here..." required />
              <button class="btn btn-primary" type="submit">Send</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
