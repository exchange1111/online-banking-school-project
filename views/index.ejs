<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Bank | Secure Banking</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="main-header">
      <div class="container header-inner">
        <div class="brand">
          <span class="brand-mark">U</span>
          <span>Urban Bank</span>
        </div>

        <nav class="nav-menu">
          <a href="/">Home</a>
          <% if (user) { %>
            <% if (user.role === 'admin') { %>
              <a href="/admin">Admin</a>
            <% } else { %>
              <a href="/dashboard">Dashboard</a>
              <a href="/chat">Support</a>
            <% } %>
            <form action="/logout" method="POST" style="display:inline; margin:0;">
              <button type="submit">Logout</button>
            </form>
          <% } else { %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <div class="container">
        <section class="hero">
          <div class="hero-copy">
            <h1>Smart banking for the next generation.</h1>
            <p>
              Manage your money with confidence using a modern digital bank designed for simple account management,
              secure balance updates, and token-based withdrawal support.
            </p>

            <div class="hero-actions">
              <a class="btn btn-primary" href="/register">Open an account</a>
              <a class="btn btn-secondary" href="/login">Sign in</a>
            </div>
          </div>

          <div class="card">
            <div class="stat-grid">
              <div class="stat-box">
                <div class="metric">
                  <strong>1.2M+</strong>
                  <span>Secure</span>
                </div>
                <p>Transactions processed</p>
              </div>
              <div class="stat-box">
                <div class="metric">
                  <strong>24/7</strong>
                  <span>Always</span>
                </div>
                <p>Customer service support</p>
              </div>
              <div class="stat-box">
                <div class="metric">
                  <strong>99.9%</strong>
                  <span>Reliable</span>
                </div>
                <p>Platform stability</p>
              </div>
            </div>
          </div>
        </section>

        <section class="feature-grid">
          <article class="feature-card">
            <h3>Admin balance control</h3>
            <p>Only administrators can adjust user balances from a secure dashboard.</p>
          </article>
          <article class="feature-card">
            <h3>Withdrawal token system</h3>
            <p>Customers request withdrawals through support and receive a token after admin approval.</p>
          </article>
          <article class="feature-card">
            <h3>Modern experience</h3>
            <p>Optimized for speed, readability, and a more polished student project presentation.</p>
          </article>
        </section>
      </div>
    </main>
  </body>
</html>
