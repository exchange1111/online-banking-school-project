<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Bank | Private Banking & Digital Finance</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="main-header">
      <div class="container header-inner">
        <div class="brand">
          <span class="brand-mark">U</span>
          <span>Urban Bank</span>
        </div>

        <nav class="nav-menu">
          <a href="/">Home</a>
          <% if (user) { %>
            <% if (user.role === 'admin') { %>
              <a href="/admin">Admin</a>
            <% } else { %>
              <a href="/dashboard">Dashboard</a>
              <a href="/transactions">Transactions</a>
              <a href="/chat">Support</a>
            <% } %>
            <form action="/logout" method="POST" style="display:inline; margin:0;">
              <button type="submit">Logout</button>
            </form>
          <% } else { %>
            <a href="/login">Login</a>
            <a href="/register">Register</a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <div class="container">
        <section class="hero">
          <div class="hero-copy">
            <span class="eyebrow">Private banking, simplified</span>
            <h1>Banking that keeps your money moving with confidence.</h1>
            <p>
              Urban Bank offers secure digital banking for everyday life — from account management
              and spending visibility to fast support and withdrawal approvals.
            </p>

            <div class="hero-actions">
              <a class="btn btn-primary" href="/register">Open an account</a>
              <a class="btn btn-secondary" href="/login">Sign in</a>
            </div>
          </div>

          <div class="card premium-card">
            <div class="mini-header">
              <span class="status-dot"></span>
              <span>Account overview</span>
            </div>

            <div class="balance-wrap">
              <p>Available balance</p>
              <h2>$24,860.50</h2>
            </div>

            <div class="stat-grid compact-grid">
              <div class="stat-box">
                <div class="metric">
                  <strong>2.4%</strong>
                  <span>Yield</span>
                </div>
                <p>Monthly growth</p>
              </div>
              <div class="stat-box">
                <div class="metric">
                  <strong>24/7</strong>
                  <span>Live</span>
                </div>
                <p>Support access</p>
              </div>
            </div>
          </div>
        </section>

        <section class="feature-grid">
          <article class="feature-card">
            <div class="feature-icon">01</div>
            <h3>Smart account management</h3>
            <p>Secure balance monitoring, better visibility, and a cleaner way to manage cash flow.</p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">02</div>
            <h3>Fast withdrawal support</h3>
            <p>Request withdrawals through secure support channels and receive a verified token after approval.</p>
          </article>

          <article class="feature-card">
            <div class="feature-icon">03</div>
            <h3>Transparent transactions</h3>
            <p>Review every change in your account history with accurate records and clear activity logs.</p>
          </article>
        </section>
      </div>
    </main>
  </body>
</html>
