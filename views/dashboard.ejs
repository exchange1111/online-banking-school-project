<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Bank | Dashboard</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="main-header">
      <div class="container header-inner">
        <div class="brand">
          <span class="brand-mark">U</span>
          <span>Urban Bank</span>
        </div>
        <nav class="nav-menu">
          <a href="/dashboard">Dashboard</a>
          <a href="/transactions">Transactions</a>
          <a href="/chat">Support</a>
          <form action="/logout" method="POST" style="display:inline; margin:0;">
            <button type="submit">Logout</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <div class="container">
        <h1 class="page-title">Welcome, <%= user.name %></h1>
        <p class="subtle">Your secure account overview.</p>

        <div class="dashboard-grid">
          <section class="card">
            <h3>Account summary</h3>
            <div class="stat-grid">
              <div class="stat-box">
                <p>Current balance</p>
                <strong>$<%= Number(user.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
              </div>
              <div class="stat-box">
                <p>Email</p>
                <strong><%= user.email %></strong>
              </div>
            </div>

            <div class="hero-actions" style="margin-top: 20px;">
              <a class="btn btn-primary" href="/chat">Open support chat</a>
              <a class="btn btn-secondary" href="/transactions">View transactions</a>
            </div>
          </section>

          <section class="card">
            <h3>Withdrawal requests</h3>
            <% if (!requests || requests.length === 0) { %>
              <p class="note">No withdrawal requests yet.</p>
            <% } else { %>
              <table class="table">
                <thead>
                  <tr>
                    <th>Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% requests.forEach((request) => { %>
                    <tr>
                      <td>$<%= Number(request.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                      <td><span class="badge <%= request.status %>"><%= request.status %></span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } %>
          </section>
        </div>
      </div>
    </main>
  </body>
</html>
